	  <PackageReference Include="Senparc.CO2NET.AspNet" Version="2.1.4" />
	  <PackageReference Include="Senparc.CO2NET.Cache.Redis" Version="5.3.0" />
    <ProjectReference Include="..\Senparc.AI.AgentKernel\Senparc.AI.AgentKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="Microsoft.Testing.Extensions.CodeCoverage" Version="18.7.0" />
