<Project Sdk="MSTest.Sdk/4.0.1">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.1</Version>
    <PackageReleaseNotes>
      [2026-07-31] v1.0.1 增加 System.Text.Json 与依赖图回归验证
      1、升级 CO2NET AspNet 和 Redis 测试依赖
