<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.3.0</Version>
    <PackageReleaseNotes>
      [2026-07-31] v1.1.0 Add a chat Temperature parameter sample and upgrade CO2NET
      1. Configure Temperature in ChatClientAgentOptions while supporting models that do not accept the parameter
      2. Upgrade Senparc.CO2NET to 4.2.0
      [2026-08-08] v1.2.0 Add a Microsoft Agent Framework Harness Agent console sample
      1. Use AsHarnessAgent to add context compression, Todo, plan/execute modes, and tool approval
      2. Disable file access, file memory, Skills scanning, and Hosted Web Search by default to maintain least privilege
      [2026-08-13] v1.3.0 Add strict IWantToRun Chat execution examples
      1. Demonstrate the differences between RunChatStreamingAsync, RunChatResponseAsync, and compatible RunChatAsync
      2. Demonstrate that strict modes preserve upstream exceptions, sessions, Tokens, and the configured HttpClient transport chain
    </PackageReleaseNotes>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Senparc.AI.Samples.AgentKernelConsoles</RootNamespace>
    <NoWarn>SKEXP0001;SKEXP0050;SKEXP0058;SKEXP0010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="appsettings.Development.json" />
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.Development.json" Condition="Exists('appsettings.Development.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0-preview.4.26230.115" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0-preview.4.26230.115" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.4.26230.115" />
    <PackageReference Include="Microsoft.Agents.AI.Harness" Version="1.8.0-preview.260528.1" />
    <PackageReference Include="Senparc.CO2NET" Version="4.2.0" />
    <ProjectReference Include="..\..\src\Senparc.AI.AgentKernel\Senparc.AI.AgentKernel.csproj" />
  </ItemGroup>

</Project>
