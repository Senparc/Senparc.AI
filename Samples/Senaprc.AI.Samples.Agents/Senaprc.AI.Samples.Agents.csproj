<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<Version>1.0.1</Version>
		<PackageReleaseNotes>
			[2026-07-31] v1.0.1 升级 CO2NET 并清理 Newtonsoft.Json 传递依赖
			1、升级 CO2NET Core、APM 和 AspNet 组件至最新兼容版本
			2、将 AutoGen 元包拆分为实际使用的 Core、Mistral 和 SemanticKernel 组件
		</PackageReleaseNotes>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<NoWarn>SKEXP0050;</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="bak\**" />
		<EmbeddedResource Remove="bak\**" />
		<None Remove="bak\**" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="appsettings.Development.json" />
		<None Remove="appsettings.json" />
	</ItemGroup>

	<ItemGroup>

		<Content Include="appsettings.Development.json">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>

		<Content Include="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AutoGen.Core" Version="0.2.3" />
		<PackageReference Include="AutoGen.Mistral" Version="0.2.3" />
		<PackageReference Include="AutoGen.SemanticKernel" Version="0.2.3" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="11.0.0-preview.4.26230.115" />
		<PackageReference Include="Microsoft.SemanticKernel.Plugins.Web" Version="1.76.0-alpha" />
		<PackageReference Include="Senparc.CO2NET" Version="4.2.0" />
		<PackageReference Include="Senparc.CO2NET.APM" Version="2.2.0" />
		<PackageReference Include="Senparc.CO2NET.AspNet" Version="2.1.4" />
		<PackageReference Include="Senparc.Weixin.Work" Version="3.30.2" />
		<PackageReference Include="Senparc.Weixin.Work.Middleware" Version="1.5.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Senparc.AI.Agents\Senparc.AI.Agents.csproj" />
		<ProjectReference Include="..\..\src\Senparc.AI.Kernel\Senparc.AI.Kernel.csproj" />
		<ProjectReference Include="..\..\src\Senparc.AI\Senparc.AI.csproj" />
	</ItemGroup>

</Project>
